# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/get-me-a-chai?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-min-32-characters

# GitHub OAuth (Login Provider)
GITHUB_ID=your-github-app-id
GITHUB_SECRET=your-github-app-secret

# Optional: Add more providers
# GOOGLE_ID=your-google-client-id
# GOOGLE_SECRET=your-google-client-secret
# LINKEDIN_ID=your-linkedin-client-id
# LINKEDIN_SECRET=your-linkedin-client-secret

# Node Environment
NODE_ENV=development
